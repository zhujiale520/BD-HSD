+@triton.jit
+def _fixed_fused_rms_norm_kernel(
+    input_ptr, residual_ptr, weight_ptr, input_stride,
+    H: tl.constexpr, EPS: tl.constexpr, BLOCK: tl.constexpr,
+):
+    row = tl.program_id(0)
+    cols = tl.arange(0, BLOCK)
+    valid = cols < H
+    x = tl.load(input_ptr + row * input_stride + cols, valid, other=0).to(tl.float32)
+    residual = tl.load(residual_ptr + row * H + cols, valid, other=0).to(tl.float32)
+    # Match the CUDA scalar kernel's BF16/FP16 residual rounding boundary.
+    z = (x + residual).to(input_ptr.dtype.element_ty)
+    zf = z.to(tl.float32)
+    variance = tl.sum(zf * zf, 0) / H
+    inv_std = tl.rsqrt(variance + EPS)
+    normalized = (zf * inv_std).to(input_ptr.dtype.element_ty)
+    weight = tl.load(weight_ptr + cols, valid, other=0).to(tl.float32)
+    tl.store(residual_ptr + row * H + cols, z, valid)
+    tl.store(input_ptr + row * input_stride + cols,
+             normalized.to(tl.float32) * weight, valid)
+
