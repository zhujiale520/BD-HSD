+    hidden = input.shape[-1]
+    if residual.shape != input.shape or weight.numel() != hidden:
+        raise ValueError("fixed fused RMSNorm shape mismatch")
+    _fixed_fused_rms_norm_kernel[(input.numel() // hidden,)](
+        input, residual, weight, input.stride(-2), hidden, float(epsilon),
+        triton.next_power_of_2(hidden), num_warps=4, enable_fp_fusion=False)
